<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootBox"   styleClass="main-container" spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kutkovmax.jfxtu4.controller.MachineController">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="appTitleLabel" styleClass="app-title" text="%app.title" />

        <Button fx:id="openButton" styleClass="tool-button" text="%btn.open" />
        <Button fx:id="saveButton" styleClass="tool-button" text="%btn.save" />

        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="langButton" styleClass="tool-button" text="RU" />
        <Button fx:id="helpButton" styleClass="tool-button" text="?" />
    </HBox>

    <VBox fx:id="mainContent" spacing="12" VBox.vgrow="ALWAYS">
        <StackPane fx:id="tapeContainer" styleClass="tape-container" />

        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="backToEditButton" styleClass="action-button" text="%btn.back" visible="false" managed="${backToEditButton.visible}" />
            <Button fx:id="instantButton" styleClass="action-button" text="%btn.instant" visible="false" managed="${instantButton.visible}" />
            <Button fx:id="quickButton" styleClass="action-button" text="%btn.quick" visible="false" managed="${quickButton.visible}" />
            <Button fx:id="stepButton" styleClass="action-button" text="%btn.step" visible="false" managed="${stepButton.visible}" />
            <Button fx:id="startButton" styleClass="action-button, start-button" text="%btn.start" managed="${startButton.visible}" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="24">
            <Label fx:id="statusLabel" styleClass="status-label" wrapText="true" />
        </HBox>

        <TextArea fx:id="programInput" styleClass="code-editor" VBox.vgrow="ALWAYS" />
    </VBox>

    <ScrollPane fx:id="helpContainer" fitToWidth="true" visible="false" managed="${helpContainer.visible}" VBox.vgrow="ALWAYS" styleClass="help-scroll">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>


            <Label fx:id="helpMainTitle" text="%help.title" styleClass="help-title" />

            <Label fx:id="helpAboutHeader" text="%help.about.title" styleClass="help-header" />
            <Label fx:id="helpAboutText" text="%help.about.text" wrapText="true" />
            <Label fx:id="helpAuthor" text="%help.author" />

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="helpSource" text="%help.source" />
                <Hyperlink fx:id="githubLink" text="github.com/kutkovmax/jfxtu4" styleClass="help-back-link" />
            </HBox>

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="helpInspired" text="%help.inspired" />
                <Hyperlink fx:id="inspiredLink" text="github.com/lxyd/jstu4" styleClass="help-back-link" />
            </HBox>

            <Label fx:id="helpManualTitle" text="%help.manual.title" styleClass="help-header" />
            <Label fx:id="helpManualFormat" text="%help.manual.format" styleClass="help-subheader" />

            <VBox spacing="2">
                <Label fx:id="helpManualQ" text="%help.manual.q" />
                <Label fx:id="helpManualA" text="%help.manual.a" />
                <Label fx:id="helpManualV" text="%help.manual.v" />
                <Label fx:id="helpManualQP" text="%help.manual.qp" />
            </VBox>

            <VBox spacing="2">
                <Label fx:id="helpManualCmdRight" text="%help.manual.cmd.right" />
                <Label fx:id="helpManualCmdLeft" text="%help.manual.cmd.left" />
                <Label fx:id="helpManualCmdStay" text="%help.manual.cmd.stay" />
                <Label fx:id="helpManualCmdHalt" text="%help.manual.cmd.halt" />
            </VBox>

            <Label fx:id="helpHotkeysTitle" text="%help.hotkeys.title" styleClass="help-header" />
            <VBox spacing="2">
                <Label fx:id="helpHotkeysEditRun" text="%help.hotkeys.edit.run" />
                <Label fx:id="helpHotkeysEditTapeEnter" text="%help.hotkeys.edit.tape.enter" />
                <Label fx:id="helpHotkeysRunToggleQuick" text="%help.hotkeys.run.toggle_quick" />
                <Label fx:id="helpHotkeysRunStep" text="%help.hotkeys.run.step" />
                <Label fx:id="helpHotkeysRunStop" text="%help.hotkeys.run.stop" />
            </VBox>

            <Label fx:id="helpExampleTitle" text="%help.example.title" styleClass="help-header" />
            <Label fx:id="helpExampleText" text="%help.example.text" wrapText="true" style="-fx-font-family: 'JetBrains Mono', Consolas, 'Courier New', monospace; -fx-font-size: 13px;" />
        </VBox>
    </ScrollPane>
</VBox>